<Window x:Class="LicenseSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Sample" Height="350" Width="525" Closing="MainWindow_Closing">
    <StackPanel Margin="10,0">
        <Label Name="labelLicense"/>
        <TextBox Name="textBoxLicenseKey" 
                 ToolTip="Enter license key here and press return to activate the key." 
                 PreviewKeyDown="textBoxLicenseKey_PreviewKeyDown" />
    </StackPanel>
</Window>
